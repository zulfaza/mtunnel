{
  "name": "mtunnel",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "oxfmt --check .",
    "format:write": "oxfmt --write .",
    "dev:api": "turbo dev --filter=@tunnel/api",
    "dev:landing": "turbo dev --filter=@tunnel/landing",
    "dev:dashboard": "turbo dev --filter=@tunnel/dashboard",
    "test:api": "turbo test --filter=@tunnel/api",
    "test:landing": "turbo test --filter=@tunnel/landing",
    "test:dashboard": "turbo test --filter=@tunnel/dashboard",
    "build:cli": "make -C apps/cli build",
    "test:cli": "make -C apps/cli test",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "oxfmt": "^0.58",
    "oxlint": "^1.73",
    "turbo": "^2.10",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.12.3"
}
