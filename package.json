{
  "name": "mtunnel",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "build": "vp run -r build",
    "test": "vp run -r build && vp run -r test",
    "lint": "vp lint",
    "typecheck": "vp run -r build && vp run -r typecheck",
    "format": "vp fmt --check .",
    "format:write": "vp fmt --write .",
    "dev:api": "vp run --filter @tunnel/api dev",
    "dev:landing": "vp run --filter @tunnel/landing dev",
    "dev:dashboard": "vp run --filter @tunnel/dashboard dev",
    "dev:mobile": "vp run --filter @tunnel/mobile dev",
    "test:api": "vp run --filter @tunnel/api test",
    "test:landing": "vp run --filter @tunnel/landing test",
    "test:dashboard": "vp run --filter @tunnel/dashboard test",
    "build:cli": "make -C apps/cli build",
    "test:cli": "make -C apps/cli test",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "typescript": "^5",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@10.12.3"
}
