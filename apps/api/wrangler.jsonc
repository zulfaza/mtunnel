{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "d208f39f5e99d9721643730ff43b738b",
  "name": "mtunnel-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TUNNELS",
        "class_name": "TunnelDO",
      },
      {
        "name": "REGISTRY",
        "class_name": "RegistryDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TunnelDO"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["RegistryDO"],
    },
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
    {
      "name": "PROXY_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 300,
        "period": 60,
      },
    },
    {
      "name": "PREVIEW_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
  ],
  "d1_databases": [
    {
      "binding": "DOMAINS",
      "database_name": "mtunnel-domains",
      "database_id": "d73b0447-a7ec-47c8-a804-30578f053b7c",
      "migrations_dir": "migrations",
      "remote": true,
    },
  ],
  "r2_buckets": [
    {
      "binding": "PREVIEWS",
      "bucket_name": "mtunnel-previews",
    },
    {
      "bucket_name": "mtunnel-previews",
      "binding": "mtunnel_previews",
      "remote": true,
    },
  ],
  "triggers": {
    "crons": ["23 * * * *"],
  },
  "vars": {
    "TUNNEL_DOMAIN": "makarima.xyz",
    "PREVIEW_DOMAIN": "preview.makarima.xyz",
    "CUSTOM_DOMAIN_CNAME": "cname.makarima.xyz",
    "WORKOS_CLIENT_ID": "client_01K65Z0KMSGX9H9XQDN5TECBYD",
    "DEV_ROUTING": "false",
    "REQUEST_TIMEOUT_MS": "30000",
    "MAX_PENDING_REQUESTS": "100",
    "MAX_REQUEST_BYTES": "52428800",
    "MAX_RESPONSE_BYTES": "104857600",
    "MAX_PREVIEW_FILE_BYTES": "104857600",
    "MAX_PREVIEW_FILES": "500",
    "PREVIEW_TTL_SECONDS": "604800",
    "HEARTBEAT_INTERVAL_MS": "20000",
    "HEARTBEAT_TIMEOUT_MS": "60000",
    "POSTHOG_HOST": "https://eu.i.posthog.com",
  },
  // Secrets: AUTH_SECRET, WORKOS_API_KEY, CLOUDFLARE_API_TOKEN, CLOUDFLARE_ZONE_ID, POSTHOG_API_KEY
  "routes": [
    {
      "pattern": "*.makarima.xyz/*",
      "zone_id": "3a5b618dd10571f2c8b61df91aca11ee",
      "custom_domain": false,
    },
    {
      "pattern": "api.makarima.xyz",
      "custom_domain": true,
    },
    {
      "pattern": "cname.makarima.xyz",
      "custom_domain": true,
    },
  ],
}
