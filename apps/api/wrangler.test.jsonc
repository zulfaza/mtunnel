{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mtunnel-api-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "vars": {
    "TUNNEL_DOMAIN": "worker.test",
    "PREVIEW_DOMAIN": "preview.worker.test",
    "CUSTOM_DOMAIN_CNAME": "cname.worker.test",
    "REQUEST_TIMEOUT_MS": "500",
    "MAX_PENDING_REQUESTS": "100",
  },
  "durable_objects": {
    "bindings": [
      { "name": "TUNNELS", "class_name": "TunnelDO" },
      { "name": "REGISTRY", "class_name": "RegistryDO" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TunnelDO"] },
    { "tag": "v2", "new_sqlite_classes": ["RegistryDO"] },
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "PROXY_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 300, "period": 60 },
    },
    {
      "name": "PREVIEW_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "d1_databases": [
    {
      "binding": "DOMAINS",
      "database_name": "mtunnel-domains",
      "database_id": "local",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "PREVIEWS", "bucket_name": "mtunnel-previews" },
    { "binding": "mtunnel_previews", "bucket_name": "mtunnel-previews" },
  ],
}
