{
  "name": "@tunnel/core",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "vp lint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vp test run --passWithNoTests"
  },
  "dependencies": {
    "@tunnel/config": "workspace:*",
    "effect": "catalog:",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "@tunnel/tsconfig": "workspace:*",
    "typescript": "^5",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
